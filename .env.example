# Database Configuration
DB_HOST=localhost
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=chatapp

# Application Configuration
APP_NAME="Realtime Chat App"
APP_ENV=development
APP_DEBUG=true

# Security Configuration
SESSION_TIMEOUT=1800
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION=900

# File Upload Configuration
MAX_IMAGE_SIZE=10485760
MAX_VIDEO_SIZE=52428800
MAX_DOCUMENT_SIZE=20971520
UPLOAD_PATH=php/images/

# Feature Flags
ENABLE_FILE_SHARING=true
ENABLE_VIDEO_CALLS=false
ENABLE_GROUPS=false

# API Configuration
API_VERSION=v1
API_RATE_LIMIT=100

# Email Configuration (for future email verification)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# WebSocket Configuration (for future implementation)
WEBSOCKET_HOST=localhost
WEBSOCKET_PORT=8080

# Third-party Services
# TURN_SERVER_URL=
# TURN_USERNAME=
# TURN_PASSWORD=
